includes:
    - vendor/larastan/larastan/extension.neon
    - vendor/nesbot/carbon/extension.neon

parameters:
    paths:
        - app/
        - bootstrap/app.php
        - config/
        - database/
        - routes/

    level: 7

    # Los eventos de Laravel (p. ej. Logout::$user) declaran en PHPDoc tipos más estrictos que la realidad.
    treatPhpDocTypesAsCertain: false
